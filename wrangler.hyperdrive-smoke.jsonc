{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "factsport-v2-db-smoke",
  "main": "workers/hyperdrive-smoke.ts",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "r2_buckets": [{ "binding": "FACTSPORT_MEDIA_BUCKET", "bucket_name": "factsport-v2-media-staging" }],
  "hyperdrive": [
    {
      "binding": "FACTSPORT_HYPERDRIVE",
      "id": "895cca4c06104b8ab9f7c1b72a8ba18f"
    }
  ]
}
