{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "factsport-v2-db-smoke",
  "main": "workers/hyperdrive-smoke.ts",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "r2_buckets": [{ "binding": "MEDIA_BUCKET", "bucket_name": "factsport-v2-media-staging" }],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "08cee41a81be4c3980450be9563af5e2"
    }
  ]
}
