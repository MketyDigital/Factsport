{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "factsport-v2-schedule-sync",
  "main": "workers/factsport-schedule-sync.mjs",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "triggers": { "crons": ["15 3,15 * * *"] },
  "hyperdrive": [
    { "binding": "FACTSPORT_HYPERDRIVE", "id": "eb634fef8bb443839fd0847c6c370f85" }
  ]
}
