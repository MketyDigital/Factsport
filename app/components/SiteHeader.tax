import Link from "next/link";
import { createClient } from "@/app/lib/supabase/server";
import { User, Trophy, Radio, LogIn, LayoutDashboard } from "lucide-react";

export default async function SiteHeader() {
  const supabase = createClient();
  const { data: { user } } = await supabase.auth.getUser();

  return (
    <header className="sticky top-0 z-50 bg-[#0a1428] text-white border-b border-white/10 shadow-lg">
      <div className="max-w-7xl mx-auto px-4 h-14 flex items-center justify-between">
        
        {/* 1. LOGO AREA */}
        <Link href="/" className="flex items-center gap-2 shrink-0">
            {/* Replace '/logo.png' with your actual file path in public folder */}
            {/* We set a max-width so it doesn't overflow on mobile */}
            <img src="/logo.png" alt="FactSport" className="h-8 w-auto max-w-[100px] object-contain" />
        </Link>

        {/* 2. NAVIGATION LINKS (Hidden on tiny screens, Visible on mobile) */}
        <div className="flex items-center gap-2 md:gap-4">
            
            {/* LIVE BUTTON */}
            <Link href="/live" className="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/5 hover:bg-white/10 transition border border-white/5">
                <Radio size={14} className="text-red-500 animate-pulse" />
                <span className="text-[10px] font-bold hidden sm:inline">Live Center</span>
                <span className="text-[10px] font-bold sm:hidden">Live</span>
            </Link>

            {/* PREDICT BUTTON */}
            <Link href="/vip/upgrade" className="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-gradient-to-r from-yellow-500 to-yellow-600 text-black hover:from-yellow-400 transition shadow-lg">
                <Trophy size={14} />
                <span className="text-[10px] font-black hidden sm:inline">Predict & Win</span>
                <span className="text-[10px] font-black sm:hidden">Win</span>
            </Link>

            {/* LOGIN / DASHBOARD BUTTON */}
            {user ? (
                <Link href="/dashboard" className="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-blue-600 hover:bg-blue-500 transition shadow-lg border border-blue-400">
                    <LayoutDashboard size={14} />
                    <span className="text-[10px] font-bold hidden sm:inline">Dashboard</span>
                </Link>
            ) : (
                <Link href="/login" className="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white text-black hover:bg-slate-200 transition font-bold text-[10px]">
                    <LogIn size={14} />
                    <span className="hidden sm:inline">Login</span>
                </Link>
            )}

        </div>
      </div>
    </header>
  );
}